# name: test/sql/secret.test
# description: Feishu Secret Manager registration, validation, and redaction
# group: [sql]

require feishu_bitable

statement ok
CREATE TEMPORARY SECRET feishu_valid (
    TYPE feishu,
    APP_ID 'cli_test_app',
    APP_SECRET 'super-secret-value'
);

query III
SELECT type, provider, secret_string NOT LIKE '%super-secret-value%'
FROM duckdb_secrets()
WHERE name = 'feishu_valid';
----
feishu	config	true

query I
SELECT sum(entry = 'app_secret=redacted')
FROM (
    SELECT unnest(split(secret_string, ';')) AS entry
    FROM duckdb_secrets()
    WHERE name = 'feishu_valid'
);
----
1

statement error
CREATE TEMPORARY SECRET feishu_missing_id (
    TYPE feishu,
    APP_SECRET 'never-shown'
);
----
Invalid Input Error: Feishu secret requires non-empty APP_ID

statement error
CREATE TEMPORARY SECRET feishu_missing_secret (
    TYPE feishu,
    APP_ID 'cli_test_app'
);
----
Invalid Input Error: Feishu secret requires non-empty APP_SECRET

statement error
CREATE TEMPORARY SECRET feishu_empty_id (
    TYPE feishu,
    APP_ID '',
    APP_SECRET 'never-shown'
);
----
Invalid Input Error: Feishu secret requires non-empty APP_ID

statement error
CREATE TEMPORARY SECRET feishu_empty_secret (
    TYPE feishu,
    APP_ID 'cli_test_app',
    APP_SECRET ''
);
----
Invalid Input Error: Feishu secret requires non-empty APP_SECRET

# USER_ACCESS_TOKEN is an accepted alternative to APP_ID + APP_SECRET for
# environments where only a delegated user token is available (e.g. lark-cli).
statement ok
CREATE TEMPORARY SECRET feishu_token_only (
    TYPE feishu,
    USER_ACCESS_TOKEN 'u-sensitive-user-token-value'
);

query III
SELECT type, provider, secret_string NOT LIKE '%u-sensitive-user-token-value%'
FROM duckdb_secrets()
WHERE name = 'feishu_token_only';
----
feishu	config	true

query I
SELECT sum(entry = 'user_access_token=redacted')
FROM (
    SELECT unnest(split(secret_string, ';')) AS entry
    FROM duckdb_secrets()
    WHERE name = 'feishu_token_only'
);
----
1

# USER_ACCESS_TOKEN takes precedence over application credentials. The secret
# stores only the selected mode, so no app_secret entry is exposed.
statement ok
CREATE TEMPORARY SECRET feishu_token_preferred (
    TYPE feishu,
    APP_ID 'cli-ignored-app-id',
    APP_SECRET 'ignored-app-secret',
    USER_ACCESS_TOKEN 'u-preferred-user-token'
);

query III
SELECT type, provider,
       secret_string NOT LIKE '%ignored-app-secret%'
       AND secret_string NOT LIKE '%app_secret=%'
       AND secret_string LIKE '%user_access_token=redacted%'
FROM duckdb_secrets()
WHERE name = 'feishu_token_preferred';
----
feishu	config	true

query I
SELECT sum(entry = 'user_access_token=redacted')
FROM (
    SELECT unnest(split(secret_string, ';')) AS entry
    FROM duckdb_secrets()
    WHERE name = 'feishu_token_preferred'
);
----
1

# An empty USER_ACCESS_TOKEN is rejected.
statement error
CREATE TEMPORARY SECRET feishu_empty_token (
    TYPE feishu,
    USER_ACCESS_TOKEN ''
);
----
Invalid Input Error: Feishu secret requires non-empty USER_ACCESS_TOKEN
